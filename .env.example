# Copy to .env and fill in. .env is gitignored.
#
# WARNING: never rename these with a VITE_ prefix. Vite inlines any VITE_*
# variable into the client bundle, which would publish your Stripe secret key
# to GitHub Pages. These are read by shell scripts only, never by the app.

# Developers > API keys. Use sk_test_... to rehearse, sk_live_... for the real link.
STRIPE_SECRET_KEY=sk_test_replace_me

# The Capsule Slab price id, from its product page in the Stripe dashboard.
STRIPE_PRICE_ID=price_replace_me

# Where Stripe sends buyers after payment.
THANK_YOU_URL=https://jalbertcode.github.io/3d-printing-store/#/thank-you
